{
  "name": "@tuxery/matcher",
  "version": "0.0.0",
  "private": true,
  "description": "Tuxery's package deduplication engine: scores and groups packages across sources by name distance, app IDs, and icon filenames",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint src",
    "test": "vitest run"
  },
  "dependencies": {
    "@tuxery/sources": "workspace:*"
  },
  "devDependencies": {
    "oxlint": "^1.76.0",
    "typescript": "7.0.2",
    "vitest": "4.1.10"
  }
}
