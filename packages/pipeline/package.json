{
  "name": "@tuxery/pipeline",
  "version": "0.0.0",
  "private": true,
  "description": "Orchestrates @tuxery/sources and @tuxery/curator end to end and publishes the resulting dataset to @tuxery/store",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "tsx src/main.ts",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint src",
    "test": "vitest run"
  },
  "dependencies": {
    "@tuxery/curator": "workspace:*",
    "@tuxery/sources": "workspace:*",
    "@tuxery/store": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "20.19.0",
    "oxlint": "^1.76.0",
    "tsx": "^4.20.6",
    "typescript": "7.0.2",
    "vitest": "4.1.10"
  }
}
