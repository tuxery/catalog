{
  "name": "@tuxery/sources",
  "version": "0.0.0",
  "private": true,
  "description": "Tuxery's source connectors: normalized package types and async clients for Flathub, Snapcraft, AppImage and native package sources",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "refresh": "tsx src/refresh.ts",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint src",
    "test": "vitest run"
  },
  "dependencies": {
    "fast-xml-parser": "^5.10.1",
    "tar": "^7.5.22"
  },
  "devDependencies": {
    "@types/node": "20.19.0",
    "oxlint": "^1.76.0",
    "tsx": "^4.20.6",
    "typescript": "7.0.2",
    "vitest": "4.1.10"
  }
}
