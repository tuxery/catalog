{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "array",
  "items": {
    "type": "object",
    "properties": {
      "id": {
        "type": "string",
        "description": "The CatalogApp id this category was assigned to, e.g. 'pacman-aur:wings3d'."
      },
      "category": {
        "anyOf": [
          {
            "type": "string",
            "enum": [
              "Developer Tools",
              "Science",
              "Education",
              "Security",
              "Finance",
              "Photo & Video",
              "Music & Audio",
              "Graphics & Design",
              "Internet & Communication",
              "Productivity",
              "Business",
              "News & Weather",
              "Travel & Navigation",
              "Books & Reference",
              "System Tools",
              "Settings",
              "Utilities"
            ]
          },
          {
            "type": "string",
            "enum": [
              "Action",
              "Adventure",
              "Arcade",
              "Board & Cards",
              "Puzzle",
              "Educational",
              "Role-Playing",
              "Simulation",
              "Sports",
              "Strategy"
            ]
          }
        ],
        "description": "The assigned label — an app category or a game genre, consistent with the app's contentType."
      },
      "reason": {
        "type": "string",
        "description": "Why the LLM assigned this category — for auditability."
      }
    },
    "required": [
      "id",
      "category",
      "reason"
    ],
    "additionalProperties": false
  },
  "title": "Enrich: LLM classifications",
  "description": "LLM-assigned categories for apps the deterministic signals couldn't classify — checked last in pickCategoryLabel, just before the 'To Classify' fallback. Generated by `pnpm classify-llm` (Gemini API), committed and consumed at build time; never hand-edited."
}
