{
  "$comment": "What tuxery/catalog's publish() writes to Turso and tuxery/app's catalog.ts reads back. Kept byte for byte identical in catalog (src/store/store-contract.json) and app (src/store-contract.json): each repo's unit tests pin its own code to this file, and each repo's CI compares its copy with the other repo's (the same-named branch, else main). Change both copies together, on same-named branches.",
  "summaryColumns": [
    "id",
    "name",
    "short_description",
    "icon_url",
    "kind",
    "content_type",
    "category",
    "rating_average",
    "rating_count",
    "packages_json"
  ],
  "listingSizes": {
    "trending": 60,
    "categoryPreview": 12
  },
  "mustHaveListing": "mustHave",
  "familyGamesListing": "familyGames",
  "browseKeys": {
    "metaKey": "browseKeys",
    "fields": [
      "generation",
      "sourceIdsChunkSize",
      "freeCounts",
      "categoryIds",
      "ageFilter",
      "subcategories"
    ]
  },
  "ageBrackets": {
    "column": "age_bracket",
    "values": [3, 7, 12, 16, 18],
    "filters": [3, 7, 12, 16]
  },
  "unsetFilter": "*",
  "metaKeyFormats": {
    "count": "count:{generation}:{interface}:{type}:{source}:{category}",
    "countFree": "countFree:{generation}:{interface}:{type}:{source}:{category}",
    "countAge": "countAge:{generation}:{age}:{license}:{interface}:{type}:{source}:{category}",
    "sourceIds": "sourceIds:{generation}:{source}:{chunk}",
    "categoryIds": "categoryIds:{generation}:{chunk}:{category}",
    "ageIds": "ageIds:{generation}:{age}:{type}:{chunk}",
    "listingRows": "listingRows:{listing}",
    "countSub": "countSub:{generation}:{interface}:{type}:{license}:{age}:{category}:{subcategory}",
    "subcategoryIds": "subcategoryIds:{generation}:{chunk}:{category}:{subcategory}",
    "subcategoryCounts": "subcategoryCounts:{type}"
  }
}
